# 实际凭证优先放项目根目录 .env；也可放 backend/.env，后者覆盖根配置。
XHS_MCP=http://127.0.0.1:18060/mcp
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURE_KEY=
# 空值时由后端用 Web Key 构造官方远程 URL。
AMAP_MCP_URL=
# Agnes 兼容 /chat/completions 服务；base URL 包含 /v1 等供应商前缀。
# 调用固定直连并开启 thinking；按文本/图文/修复任务使用 16384/32768/32768 输出预算。
AGNES_URL=
AGNES_KEY=
AGNES_MODEL=
# 也兼容 MODEL_BASE_URL / MODEL_API_KEY / MODEL_ID，优先使用这些同名非空项。
